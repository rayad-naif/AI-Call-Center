# Public https URL of this app (no trailing slash).
BASE_URL=https://calls.yourdomain.com
PORT=3000

# First Marketplace app ("account app"): Target User Account, distribution
# Company and Account. Redirect URL ${BASE_URL}/oauth/callback.
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
# Optional: override the scopes (default list is in server/config.js and the README).
# CRM_SCOPES=
# App "Shared Secret" (Advanced Settings > Auth > SSO). Signs users in from the
# custom page / custom menu link (${BASE_URL}/embed).
CRM_SSO_KEY=
# Second Marketplace app, same deployment: Target User Company ("company app").
# Redirect URL ${BASE_URL}/oauth/company/callback. Leave empty if you only
# publish the account app.
CRM_COMPANY_CLIENT_ID=
CRM_COMPANY_CLIENT_SECRET=
CRM_COMPANY_SSO_KEY=
# CRM_COMPANY_SCOPES=   (default: companies.readonly locations.readonly users.readonly)

# Optional webhook signature keys (PEM). Without them, UNINSTALL webhooks are
# double-checked by refreshing the company token.
CRM_WEBHOOK_ED25519_KEY=
CRM_WEBHOOK_RSA_KEY=

# New installs: active (licensed immediately) or pending (approve in Super Admin)
NEW_INSTALL_STATUS=active

# Super Admin: ${BASE_URL}/admin/login
ADMIN_PASSWORD=change-me-to-something-long

# 32+ random characters each. SESSION_SECRET signs logins. ENCRYPTION_KEY
# encrypts companies' Twilio/Vapi/OpenAI keys and CRM tokens at rest.
# Never change ENCRYPTION_KEY after launch: stored keys could not be read.
SESSION_SECRET=
ENCRYPTION_KEY=

# MongoDB Atlas (required on Vercel)
# Set automatically by Vercel's MongoDB Atlas integration. MONGODB_URI also works.
AI_CALL_CENTER_PLUS_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional: database name. Default: the name in the URI, else AICallCenter.
# MONGODB_DB=AICallCenter
# Days to keep call records (TTL index)
CALL_RETENTION_DAYS=365

# Protects /api/cron/sweep (Vercel Cron sends it automatically; external
# pingers send it as "X-Cron-Secret")
CRON_SECRET=
# Run the background sweep from normal traffic at most every N seconds (0 = off)
SWEEP_INTERVAL_SEC=60

# Models (billed to each company's own OpenAI key)
AGENT_MODEL=gpt-4o
GRADER_MODEL=gpt-4o-mini

# How often the Command Deck polls for live updates (ms, min 800)
LIVE_POLL_MS=1500

# Optional: lets companies attach custom portal domains automatically on Vercel
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: override which Vapi server messages are subscribed (comma-separated)
# VAPI_SERVER_MESSAGES=status-update,transcript,conversation-update,end-of-call-report,tool-calls,hang

# Local development only: without a MongoDB URI, data goes to a JSON file here.
DATA_DIR=./data

# Branding / legal pages
BRAND_NAME=AI Call Center
# Support contact is fixed in the code: IR. Solutions, idylle_radieuse@outlook.com
LEGAL_UPDATED=November 16, 2026
MARKETPLACE_URL=
